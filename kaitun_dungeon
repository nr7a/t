    local titleLabel = new("TextLabel", {
        Text = title,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -76, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = noTruncate and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
        TextScaled = noTruncate and true or false,
        Parent = row,
    })
    if noTruncate then
        new("UITextSizeConstraint", { MaxTextSize = 13, Parent = titleLabel })
    end
    if not skipI18n then
        RegisterText(titleLabel, title)
    end

    local switch = new("Frame", {
        Size = UDim2.fromOffset(40, 20),
        Position = UDim2.new(1, -10, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = Theme.Off,
        BorderSizePixel = 0,
        Parent = row,
    })
    addCorner(switch, 10)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new(0, 3, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        Parent = switch,
    })
    addCorner(knob, 7)

    local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local function render()
        if isLocked then
            TweenService:Create(switch, tweenInfo, { BackgroundColor3 = Theme.Locked }):Play()
            TweenService:Create(knob, tweenInfo, { Position = UDim2.new(0, 3, 0.5, 0) }):Play()
            row.BackgroundColor3 = Theme.Locked
            titleLabel.TextColor3 = Theme.SubText
        else
            TweenService:Create(switch, tweenInfo, { BackgroundColor3 = state and Theme.On or Theme.Off }):Play()
            TweenService:Create(knob, tweenInfo, { Position = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }):Play()
            row.BackgroundColor3 = Theme.Panel
            titleLabel.TextColor3 = Theme.Text
        end
    end
    render()

    row.Activated:Connect(function()
        if isLocked then return end
        state = not state
        render()
        callback(state)
    end)

    local toggleObj = {}
    function toggleObj:SetTitle(newTitle)
        titleLabel.Text = newTitle
    end
    function toggleObj:SetLocked(locked)
        isLocked = locked
        if locked then
            state = false
            callback(false)
        end
        render()
    end
    function toggleObj:SetVisible(visible)
        row.Visible = visible
    end
    function toggleObj:SetValue(value, fire)
        state = value == true
        render()
        if fire then callback(state) end
    end
    return toggleObj
end

