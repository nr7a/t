                ImageRectSize = Vector2.new(120, 56),
                ImageRectOffset = Vector2.new(4, 4),
                ImageTransparency = 0.28,
                ScaleType = Enum.ScaleType.Stretch,
                ResampleMode = Enum.ResamplerMode.Default,
                ZIndex = openBtn.ZIndex + 1,
