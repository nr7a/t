local hasDragonstorm = false
local hasOneShotFruit = false
local M1Fruit = false
local dragonM1ToggleObj = nil
local dragonM1SliderObj = nil
local oneShotToggleObj = nil
local function detectionLoop()
    while scriptRunning do
        task.wait(1)
        local foundDragonstorm = false
        local foundBlade = false
        local flagFruit = false

        local function scanContainer(container)
            if not container then return end
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    if item.Name == "Dragonstorm" then
                        foundDragonstorm = true
                    end
                    if string.find(string.lower(item.Name), "blade", 1, true) then
                        foundBlade = true
                    end
                    local isChop = string.find(string.lower(item.Name), "chop") ~= nil
                    if (item:GetAttribute('WeaponType') == 'Demon Fruit' or item.ToolTip == "Blox Fruit") and item:FindFirstChild("LeftClickRemote") and not isChop then
                        M1Fruit = item
                        flagFruit = true
                    end
                end
            end
        end

        if player.Character then scanContainer(player.Character) end
        scanContainer(player:FindFirstChild("Backpack"))

        if not flagFruit then M1Fruit = nil end
        hasDragonstorm = foundDragonstorm
        hasOneShotFruit = flagFruit

        if dragonM1ToggleObj then
            if hasDragonstorm then
                dragonM1ToggleObj:SetTitle(TranslateStatic("龍炮 M1"))
                dragonM1ToggleObj:SetLocked(false)
            else
                dragonM1ToggleObj:SetTitle(TranslateStatic("🔒 龍炮 M1 (需持有 Dragonstorm)"))
                dragonM1ToggleObj:SetLocked(true)
            end
        end

        if dragonM1SliderObj then
            if hasDragonstorm then
                dragonM1SliderObj:SetTitle(TranslateStatic("龍炮延遲"))
                dragonM1SliderObj:SetLocked(false)
            else
                dragonM1SliderObj:SetTitle(TranslateStatic("🔒 龍炮延遲 (需持有 Dragonstorm)"))
                dragonM1SliderObj:SetLocked(true)
            end
        end

        if oneShotToggleObj then
            
            local activeFruit = getM1FruitTool()
            local bladeActive = activeFruit and string.find(string.lower(activeFruit.Name), "blade", 1, true) ~= nil
            if bladeActive then
                oneShotToggleObj:SetTitle(TranslateStatic("切切果實不支援"))
                oneShotToggleObj:SetLocked(true)
            else
                oneShotToggleObj:SetTitle(TranslateStatic("One Shot"))
                oneShotToggleObj:SetLocked(false)
            end
        end
    end
end

