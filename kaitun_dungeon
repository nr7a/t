local function isM1FruitTool(item)
    if not item or not item:IsA("Tool") then return false end
    if item:GetAttribute("WeaponType") == "Demon Fruit" then return true end
    if item.ToolTip == "Blox Fruit" then return true end
    if item:FindFirstChild("LeftClickRemote") then return true end
    return false
end

local function getMaxCombo(tool)
    if not tool then return 5 end
    local lower = string.lower(tool.Name or "")
    if lower:find("trex", 1, true) then return 4 end
    if lower:find("pain", 1, true) then return 4 end
    if lower:find("control", 1, true) then return 4 end
    if lower:find("gas", 1, true) then return 5 end
    if lower:find("dragon", 1, true) then
        local char = player.Character
        return (char and char:FindFirstChild("DragonHybrid")) and 5 or 3
    end
    return 5
end

local function isOneShotFruit(name)
    if not name then return false end
    return string.lower(name):find("blade", 1, true) == nil
end

local function getM1FruitTool()
    local char = player.Character
    if not char then return nil end
    local fallback = nil
    for _, item in ipairs(char:GetChildren()) do
        if isM1FruitTool(item) then
            if isOneShotFruit(item.Name) then return item end
            if not fallback then fallback = item end
        end
    end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if isM1FruitTool(item) then
                if isOneShotFruit(item.Name) then return item end
                if not fallback then fallback = item end
            end
        end
    end
    return fallback
end

local function autoEquipOneShotFruit()
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local fruit = getM1FruitTool()
    if not fruit or not isOneShotFruit(fruit.Name) then return false end
    local equipped = hum:FindFirstChildOfClass("Tool")
    if equipped == fruit then return true end
    pcall(function()
        hum:EquipTool(fruit)
    end)
    return true
end

local function equipByType(toolType)
    _G.AutoEquip_SelectedType = toolType 
    if not _G.AutoEquip_Enabled then return end 

    -- Force Melee (拳法) unless changed
    if false and Config.OneShotEnabled and ONE_SHOT_LEVELS[State.LockedLevel] then
        if autoEquipOneShotFruit() then return end
    end

    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        
        if tool:IsA("Tool") and tool.ToolTip == toolType then
            pcall(function()
                hum:EquipTool(tool) 
            end)
            break
        end
    end
end
