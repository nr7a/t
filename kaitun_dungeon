        Pending = nil,
    }
    autoReturn.Arm = function(newResults)
        if not scriptRunning or not (Config.AutoStartDungeon or Config.FollowPlayerEnabled) then return end
        if newResults == true then
            autoReturn.Sent = setmetatable({}, {__mode = "k"})
            autoReturn.Pending = nil
        end
        if not autoReturn.Pending then
            autoReturn.Pending = {ReadyAt = os.clock() + 0.75, Deadline = os.clock() + 20, RetryAt = 0}
        end
    end
    autoReturn.Bind = function(remote)
        if remote.Name == "ResultsScreen" and remote:IsA("RemoteEvent") and not autoReturn.Bound[remote] then
            autoReturn.Bound[remote] = true
            addConnection(remote.OnClientEvent:Connect(function() autoReturn.Arm(true) end))
        end
    end
    autoReturn.Step = function()
        local pending = autoReturn.Pending
        if not pending then return end
        local now = os.clock()
        if not scriptRunning or not (Config.AutoStartDungeon or Config.FollowPlayerEnabled) or now > pending.Deadline then
            autoReturn.Pending = nil
            return
        end
        if now < pending.ReadyAt or now < pending.RetryAt then return end
        local shared = ReplicatedStorage:FindFirstChild("DungeonShared")
        local remote = shared and shared:FindFirstChild("ReturnToHub")
        if not remote or not remote:IsA("RemoteEvent") then return end
        if autoReturn.Sent[remote] then autoReturn.Pending = nil; return end
        local ok, err = pcall(function() remote:FireServer() end)
        if ok then
            autoReturn.Sent[remote] = true
            autoReturn.Pending = nil
            print("[Dungeon] 已請求跳過結束等待並返回大廳")
        else
            pending.RetryAt = now + 3
            warn("[Dungeon] 自動返回請求失敗: " .. tostring(err))
        end
    end
    autoReturn.BindFolder = function(shared)
        if shared.Name ~= "DungeonShared" or autoReturn.Bound[shared] then return end
        autoReturn.Bound[shared] = true
        addConnection(shared.ChildAdded:Connect(autoReturn.Bind))
        for _, child in ipairs(shared:GetChildren()) do autoReturn.Bind(child) end
    end
    addConnection(ReplicatedStorage.ChildAdded:Connect(autoReturn.BindFolder))
    local shared = ReplicatedStorage:FindFirstChild("DungeonShared")
    if shared then autoReturn.BindFolder(shared) end
    addConnection(PlayerGui.ChildAdded:Connect(function(gui)
