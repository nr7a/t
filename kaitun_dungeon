local wideScanTime = 0
local function mainLoop()
    local wasInDungeon = false
    local lobbyReturnSince = nil
    while scriptRunning do
        task.wait(0.15)
        getRef()

        if not character or not hrp or not humanoid or humanoid.Health <= 0 then
            State.FindingNextFloor = false
            State.StatusText = T("等待角色重生...", "Waiting for respawn...")
            statusLabel:SetTitle(T("關卡：第 ", "Floor: ") .. tostring(State.LockedLevel) .. T(" 關 | 狀態：", " | Status: ") .. State.StatusText)
            continue
        end

        local map = workspace:FindFirstChild("Map")
        local dungeon = map and map:FindFirstChild("Dungeon")
        local localDungeonLevel = getCharacterDungeonLevel(player)
        if localDungeonLevel then
            wasInDungeon = true
            lobbyReturnSince = nil
        elseif wasInDungeon then
            if not lobbyReturnSince then
                lobbyReturnSince = os.clock()
                autoStartDelayDone = false
                autoStartDelayStart = lobbyReturnSince
                if minimizeDungeonPanel then pcall(minimizeDungeonPanel) end
            end
            if os.clock() - lobbyReturnSince >= 1.5 then
                wasInDungeon = false
                lobbyReturnSince = nil
            end
        else
            lobbyReturnSince = nil
        end

        if dungeon then
            
            local nearestLevel, nearestDist = nil, 600
            for _, lv in pairs(dungeon:GetChildren()) do
                local n = tonumber(lv.Name)
                local floor = lv:FindFirstChild("Floor") or lv:FindFirstChildWhichIsA("BasePart")
                if n and floor then
                    local d = (hrp.Position - floor.Position).Magnitude
                    if d < nearestDist then
                        nearestDist = d
                        nearestLevel = n
                    end
                end
            end
            if nearestLevel and State.LockedLevel ~= nearestLevel then
                State.LockedLevel = nearestLevel
                enterRoomTime = tick()
                
                State.WideScan = false
                clearPhaseStart = 0
                wideScanTarget = nil
                dungeonTeleporting = false
            end
        end

        doBuffs()
        callV4()

        if followingPlayerNow then
            State.StatusText = T("跟隨玩家中...", "Following selected player...")
        elseif State.AutoFarm then
            local ef = workspace:FindFirstChild("Enemies")
            local closest, minDist = nil, math.huge
            local priorityTargets = {}
            
            local scanRange = State.WideScan and WIDE_SCAN_RANGE or 600

            if ef then
                for _, npc in ipairs(ef:GetChildren()) do
                    if npc.Name == "Blank Buddy" or isShadow(npc.Name) then continue end
                    local npcHum  = npc:FindFirstChild("Humanoid")
                    local npcRoot = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
                    if npcHum and npcHum.Health > (Config.HealthMobThreshold or 0) and npcRoot then
                        local d = (npcRoot.Position - hrp.Position).Magnitude
                        if npc.Name == "PropHitboxPlaceholder" and d <= scanRange then
                            table.insert(priorityTargets, npcRoot)
                        end
                        if d < minDist and d <= scanRange then
                            minDist = d
                            closest = npcRoot
                        end
                    end
                end
            end

            local target = (#priorityTargets > 0) and priorityTargets[1] or closest

            State.FindingNextFloor = (target == nil) and ((tick() - enterRoomTime) >= CONFIG.EnterRoomWaitTime)

            if target then
                enterRoomTime = 0
                clearPhaseStart = 0
                pcall(function() target.CanCollide = false end)

                ensureFlyVelocity()

                local canFly = true
                if State.WideScan then
                    if wideScanTarget ~= target then
                        wideScanTarget = target
                        wideScanTime = tick()
                    end
                    local waitLeft = WIDE_SCAN_WAIT - (tick() - wideScanTime)
                    if waitLeft > 0 then
                        canFly = false
                        State.StatusText = T("偵測到遠處怪物，等待 ", "Far monster detected, waiting ") .. string.format("%.1f", waitLeft) .. T(" 秒...", "s...")
                    end
                else
                    wideScanTarget = nil
                end

                if canFly then
                    local targetPos = target.CFrame.Position + Vector3.new(0, getAboveMonsterOffset(), 0)
                    flyTo(CFrame.new(targetPos), CONFIG.TweenSpeed)
                    State.StatusText = T("飛往目標: ", "Flying to: ") .. (target.Parent and target.Parent.Name or "?")
                end
            else
                
                if clearPhaseStart == 0 then clearPhaseStart = tick() end
                if not State.WideScan and (tick() - clearPhaseStart) >= WIDE_SCAN_TRIGGER then
                    State.WideScan = true
                    print("[WideScan] 卡在出口，已放大怪物掃描範圍至 " .. tostring(WIDE_SCAN_RANGE))
                end

                local timeSinceEnter = tick() - enterRoomTime
                if timeSinceEnter < CONFIG.EnterRoomWaitTime then
                    local timeLeft = string.format("%.1f", CONFIG.EnterRoomWaitTime - timeSinceEnter)
                    State.StatusText = T("已進入第 ", "Entered floor ") .. tostring(State.LockedLevel) .. T(" 關，等待生怪 (", ", waiting for mobs (") .. timeLeft .. "s)..."
                    ensureFlyVelocity()
                else
                    if not dungeonTeleporting then
                        local mapObj = workspace:FindFirstChild("Map")
                        local dungeonObj = mapObj and mapObj:FindFirstChild("Dungeon")
                        local targetExit, exitMinDist = nil, math.huge

                        local maxExitDist = (State.LockedLevel == 15) and 2500 or 1000

                        if dungeonObj then
                            for _, level in ipairs(dungeonObj:GetChildren()) do
                                if tonumber(level.Name) then
                                    local tp = level:FindFirstChild("ExitTeleporter")
                                    if tp then
                                        local root = tp:FindFirstChild("Root") or tp:FindFirstChildWhichIsA("BasePart")
                                        if root then
                                            local d = (hrp.Position - root.Position).Magnitude
                                            if d < exitMinDist and d < maxExitDist then
                                                exitMinDist = d
                                                targetExit = root
                                            end
                                        end
                                    end
                                end
                            end
                        end

                        if targetExit and tick() - lastDungeonTeleport >= 2 then
                            dungeonTeleporting = true
                            lastDungeonTeleport = tick()
                            local exitLevel = State.LockedLevel
                            local exitWait = math.clamp(exitMinDist / math.max(CONFIG.TweenSpeed, 1) + 3, 3, 20)
                            flyTo(targetExit.CFrame, CONFIG.TweenSpeed)
                            task.spawn(function()
                                local deadline = os.clock() + exitWait
                                while scriptRunning and dungeonTeleporting
                                    and State.LockedLevel == exitLevel and os.clock() < deadline do
                                    local activeChar = player.Character
                                    local activeRoot = activeChar and activeChar:FindFirstChild("HumanoidRootPart")
                                    if not targetExit.Parent then break end
                                    if activeRoot and (activeRoot.Position - targetExit.Position).Magnitude <= 10 then
                                        task.wait(0.8)
                                        break
                                    end
                                    task.wait(0.1)
                                end
                                if State.LockedLevel == exitLevel then
                                    dungeonTeleporting = false
                                end
                            end)
                            State.StatusText = T("飛往下一關出口...", "Flying to next floor exit...")
                        else
                            pcall(function()
                                local flyBv = hrp:FindFirstChild("FlyVelocity")
                                if flyBv then flyBv:Destroy() end
                            end)
                            if autoStartFlying then
                                State.StatusText = T("飛往開始點...", "Flying to start pad...")
                            else
                                stopFly()
                                State.StatusText = State.LockedLevel == 15 and T("第15關Boss打完，擴大搜尋出口中...", "Floor 15 boss cleared, expanding exit search...") or T("尋找出口中...", "Searching for exit...")
                            end
                        end
                    end
                end
            end
        else
            State.FindingNextFloor = false
            State.WideScan = false
            clearPhaseStart = 0
            wideScanTarget = nil
            if followingPlayerNow then
                State.StatusText = T("跟隨玩家中...", "Following selected player...")
            elseif autoStartFlying then
                State.StatusText = T("飛往開始點...", "Flying to start pad...")
            else
                pcall(function()
                    local flyBv = hrp:FindFirstChild("FlyVelocity")
                    if flyBv then flyBv:Destroy() end
                end)
                stopFly()
                State.StatusText = (Config.FastAttackMob or Config.M1FruitEnabled or Config.DragonGunM1) and T("攻擊待命", "Attack Ready") or T("待機中", "Idle")
            end
        end
        statusLabel:SetTitle(T("關卡：第 ", "Floor: ") .. tostring(State.LockedLevel) .. T(" 關 | 狀態：", " | Status: ") .. State.StatusText)
    end
end

task.spawn(mainLoop)
