local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        if k ~= "Parent" then inst[k] = v end
    end
    inst.Parent = props.Parent
    return inst
end

local function addCorner(inst, radius)
    new("UICorner", { CornerRadius = UDim.new(0, radius), Parent = inst })
end

local function addStroke(inst, color, transparency, thickness)
    new("UIStroke", { Color = color, Transparency = transparency or 0, Thickness = thickness or 1, Parent = inst })
end

local function addFlowingBorder(inst, cycleSeconds, thickness, radius)
    new("UIStroke", {
        Name = "FlowingBorderBase",
        Color = Color3.fromRGB(73, 171, 214),
        Transparency = 0.38,
        Thickness = thickness or 1.4,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = inst,
    })

    local segments = {}
    local segmentCount = 12
    local spacing = 4
    local segmentLength = 7
    for index = 1, segmentCount do
        local segment = new("Frame", {
            Name = "FlowingLightFiber",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(segmentLength, 2.6),
            BackgroundColor3 = index <= 3 and Color3.fromRGB(224, 250, 255) or Color3.fromRGB(86, 219, 255),
            BackgroundTransparency = 0.16 + ((index - 1) / segmentCount) * 0.74,
            BorderSizePixel = 0,
            ZIndex = inst.ZIndex + 1,
            Parent = inst,
        })
        addCorner(segment, 3)
        segments[index] = segment
    end

    local function pointAt(distance, width, height, r, top, side, arc, perimeter)
        local d = distance % perimeter
        if d < top then return r + d, 0, 0 end
        d -= top
        if d < arc then
            local a = -math.pi * 0.5 + d / r
            return width - r + math.cos(a) * r, r + math.sin(a) * r, math.deg(a + math.pi * 0.5)
        end
        d -= arc
        if d < side then return width, r + d, 90 end
        d -= side
        if d < arc then
            local a = d / r
            return width - r + math.cos(a) * r, height - r + math.sin(a) * r, math.deg(a + math.pi * 0.5)
        end
        d -= arc
        if d < top then return width - r - d, height, 180 end
        d -= top
        if d < arc then
            local a = math.pi * 0.5 + d / r
            return r + math.cos(a) * r, height - r + math.sin(a) * r, math.deg(a + math.pi * 0.5)
        end
        d -= arc
        if d < side then return 0, height - r - d, 270 end
        d -= side
        local a = math.pi + d / r
        return r + math.cos(a) * r, r + math.sin(a) * r, math.deg(a + math.pi * 0.5)
    end

    task.spawn(function()
        local startedAt = os.clock()
        local cornerRadius = radius or 16
        local cycle = math.max(tonumber(cycleSeconds) or 7.2, 0.5)
        while inst.Parent do
            RunService.RenderStepped:Wait()
            if not inst.Parent then break end
            local scale = inst:FindFirstChildOfClass("UIScale")
            local unitScale = scale and scale.Scale or 1
            local absolute = inst.AbsoluteSize
            
            if unitScale <= 0.001 or absolute.X < 2 or absolute.Y < 2 then continue end
            local width, height = absolute.X / unitScale, absolute.Y / unitScale
            if width < 2 or height < 2 then continue end
            local r = math.max(0.5, math.min(cornerRadius, math.min(width, height) * 0.5))
            local top = math.max(0, width - 2 * r)
            local side = math.max(0, height - 2 * r)
            local arc = math.pi * r * 0.5
            local perimeter = top * 2 + side * 2 + arc * 4
            
            local travelled = (((os.clock() - startedAt) / cycle) % 1) * perimeter
            for index, segment in ipairs(segments) do
                if segment.Parent then
                    local behind = (index - 1) * spacing
                    local x, y, angle = pointAt(travelled - behind, width, height, r, top, side, arc, perimeter)
                    segment.Position = UDim2.fromOffset(x, y)
                    segment.Rotation = angle
                end
            end
        end
    end)
end

