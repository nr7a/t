local function fastAttackLoop()
    while scriptRunning do
        if (Config.FastAttackDelay or 0) > 0 then
            task.wait(Config.FastAttackDelay)
        else
            local delta = tick() - lastAttackTime
            if delta < 0.033 then
                task.wait(0.033 - delta)
            else
                task.wait()
            end
        end

        if isTyping() then continue end
        if not Config.FastAttackPlayer and not Config.FastAttackMob then continue end

        if Config.OneShotEnabled and ONE_SHOT_LEVELS[State.LockedLevel] then continue end

        local Character = player.Character
        local myHrp = Character and Character:FindFirstChild('HumanoidRootPart')
        if not Character or not myHrp then continue end

        local hum = Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local attackRange = Config.AttackRange or 380

        local BladeHits = {}
        local MobFolders = { workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("Characters") }
        for _, Mobs in ipairs(MobFolders) do
            if not Mobs then continue end
            if Mobs.Name == "Enemies" and not Config.FastAttackMob then continue end
            if Mobs.Name == "Characters" and not Config.FastAttackPlayer then continue end
            for _, Mob in ipairs(Mobs:GetChildren()) do
                if Mob == Character or not Mob:IsA("Model") or isShadow(Mob.Name) or Mob.Name == "Blank Buddy" then continue end
                local mobHrp = Mob:FindFirstChild('HumanoidRootPart')
                local mobHum = Mob:FindFirstChild('Humanoid')
                if mobHrp and mobHum and mobHum.Health > (Config.HealthMobThreshold or 0) then
                    if (mobHrp.Position - myHrp.Position).Magnitude <= attackRange then
                        BladeHits[#BladeHits + 1] = {Mob, mobHrp}
                    end
                end
            end
        end

        local Tool = Character:FindFirstChildOfClass('Tool')

        if #BladeHits > 0 then
            local isChop = Tool and string.find(string.lower(Tool.Name), "chop") ~= nil
            
            if not Tool or (Tool and (
                Tool:GetAttribute('WeaponType') == 'Melee' or
                Tool:GetAttribute('WeaponType') == 'Sword' or
                isChop or
                (Tool:GetAttribute('WeaponType') == 'Demon Fruit' and (Tool.Name == "Light-Light" or Tool.Name == "Ice-Ice"))
            )) then
                local _Head = BladeHits[1][1]:FindFirstChild('Head') or BladeHits[1][2]
                if _Head then
                    lastAttackTime = tick()
                    local sessionToken = generateRegisterHitToken()

                    pcall(function()
                        RegisterAttack:FireServer(0.1)
                        RegisterHit:FireServer(_Head, BladeHits, {}, sessionToken)
                    end)

                    if Config.M1FruitEnabled and LeftClickRemote then
                        pcall(function() LeftClickRemote:FireServer(_Head.Position) end)
                    end

                    if Config.RemoveAnimationFast and CancelEquipAnim then
                        pcall(function() CancelEquipAnim:FireServer() end)
                    end

                    if Config.DoubleAttack then
                        pcall(function()
                            RegisterAttack:FireServer(0.1)
                            RegisterHit:FireServer(_Head, BladeHits, {}, sessionToken)
                        end)
                        if Config.M1FruitEnabled and LeftClickRemote then
                            pcall(function() LeftClickRemote:FireServer(_Head.Position) end)
                        end
                        if Config.RemoveAnimationFast and CancelEquipAnim then
                            pcall(function() CancelEquipAnim:FireServer() end)
                        end
                    end

                    if Config.BypassFastAttack and remoteEvent then
                        task.spawn(function()
                            pcall(function()
                                require(ReplicatedStorage.Modules.Net):RemoteEvent('RegisterHit', true)
                                cloneref(remoteEvent):FireServer(
                                    string.gsub('RE/RegisterHit', '.', function(p)
                                        return string.char(bit32.bxor(string.byte(p), math.floor(workspace:GetServerTimeNow() / 10 % 10) + 1))
                                    end),
                                    bit32.bxor(remoteId + 909090, ReplicatedStorage.Modules.Net.seed:InvokeServer() * 2),
                                    _Head, BladeHits
                                )
                            end)
                        end)
                    end
                end
            end
        end
    end
end

