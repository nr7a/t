local function autoStartLoop()
    local lastStreamPad = nil
    local lastStreamTime = 0
    while scriptRunning do
        task.wait(0.5)

        autoStartFlying = false
        if not Config.AutoStartDungeon then
            autoStartDelayDone = false
            autoStartDelayStart = os.clock()
            continue
        end
        if getCharacterDungeonLevel(player) then
            autoStartDelayDone = false
            autoStartDelayStart = os.clock()
            continue
        end
        if hasAnotherPlayerSelected() then
            continue
        end
        if isTyping() then continue end

        if not autoStartDelayDone then
            if (os.clock() - autoStartDelayStart) >= (Config.AutoStartDelay or 15) then
                autoStartDelayDone = true
            else
                continue
            end
        end

        local padsFolder = getPadsFolder()
        if not padsFolder then continue end

        local myPad = getCurrentPad(padsFolder)
        if myPad then
            syncPadDifficulty(myPad)
            if countPlayersAtPad(myPad, true) >= 1 and (os.clock() - dungeonLastStartTime) > DUNGEON_START_COOLDOWN then
                startDungeonAtPad(myPad)
            end
        else
            local targetPad = findEmptyPad(padsFolder)
            if not targetPad then
                targetPad = findDifficultyMatchPad(padsFolder)
            end
            if targetPad then
                local padPos = getPadPosition(targetPad)
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if padPos and root then
                    local targetPos = padPos + Vector3.new(0, 3, 0)
                    local dist = (targetPos - root.Position).Magnitude
                    if dist > 3 and dist <= DUNGEON_MAX_TWEEN_DIST then
                        
                        if lastStreamPad ~= targetPad and (os.clock() - lastStreamTime) > 5 then
                            lastStreamPad = targetPad
                            lastStreamTime = os.clock()
                            pcall(function()
                                player:RequestStreamAroundAsync(targetPos)
                            end)
                        end
                        autoStartFlying = true
                        ensureFlyVelocity()
                        flyTo(CFrame.new(targetPos), CONFIG.TweenSpeed)
                    end
                end
            end
        end
    end
end

task.spawn(autoStartLoop)

local function followSelectedPlayerLoop()
    local lastCommandAt = 0
    local lastTargetPosition = nil
    while scriptRunning do
        task.wait(0.25)
        if not isFollowingAnotherPlayer() then
            followingPlayerNow = false
            lastTargetPosition = nil
            continue
        end

        local targetPlayer = Players:FindFirstChild(Config.FollowPlayerName)
        local targetChar = targetPlayer and targetPlayer.Character
        local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        local localDungeonLevel = getCharacterDungeonLevel(player)
        local targetDungeonLevel = getCharacterDungeonLevel(targetPlayer)

        if localDungeonLevel or targetDungeonLevel then
            followingPlayerNow = false
            lastTargetPosition = nil
            continue
        end

        if not targetRoot then
            followingPlayerNow = false
            lastTargetPosition = nil
            continue
        end

        followingPlayerNow = true
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            local targetCFrame = targetRoot.CFrame * CFrame.new(0, 2, 6)
            local targetPos = targetCFrame.Position
            local distance = (root.Position - targetPos).Magnitude
            local targetMoved = not lastTargetPosition or (targetPos - lastTargetPosition).Magnitude >= 8
            local commandAge = os.clock() - lastCommandAt
            if distance > 10 and commandAge >= 0.5 and (targetMoved or commandAge >= 1) then
                ensureFlyVelocity()
                flyTo(targetCFrame, CONFIG.TweenSpeed)
                lastTargetPosition = targetPos
                lastCommandAt = os.clock()
            end
        end
    end
end

