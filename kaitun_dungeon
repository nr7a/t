    local function decodeBase64(data)
        data = data:gsub("%s", "")
        local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local values = {}
        for i = 1, #alphabet do values[alphabet:sub(i, i)] = i - 1 end
        local chunks, bytes = {}, {}
        for i = 1, #data, 4 do
            local c1, c2 = data:sub(i, i), data:sub(i + 1, i + 1)
            local c3, c4 = data:sub(i + 2, i + 2), data:sub(i + 3, i + 3)
            local a, b = values[c1] or 0, values[c2] or 0
            local c, d = values[c3] or 0, values[c4] or 0
            local n = a * 262144 + b * 4096 + c * 64 + d
            bytes[#bytes + 1] = string.char(math.floor(n / 65536) % 256)
            if c3 ~= "=" and c3 ~= "" then bytes[#bytes + 1] = string.char(math.floor(n / 256) % 256) end
            if c4 ~= "=" and c4 ~= "" then bytes[#bytes + 1] = string.char(n % 256) end
            if #bytes >= 2048 then
                chunks[#chunks + 1] = table.concat(bytes)
                bytes = {}
            end
        end
        if #bytes > 0 then chunks[#chunks + 1] = table.concat(bytes) end
        return table.concat(chunks)
    end

    local assetLoader = getcustomasset or getsynasset
    if type(assetLoader) == "function" and type(writefile) == "function" then
        local ok, asset = pcall(function()
            if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(FOLDER) then
                makefolder(FOLDER)
            end
            local assetPath = FOLDER .. "/FluidSurfaceFrames_28.png"
            writefile(assetPath, decodeBase64(encodedAtlas))
            return assetLoader(assetPath)
        end)
        if ok and type(asset) == "string" then
            local fluidSurface = new("ImageLabel", {
                Name = "FluidSurface",
                Size = UDim2.new(1, -4, 1, -4),
                Position = UDim2.fromOffset(2, 2),
                BackgroundTransparency = 1,
