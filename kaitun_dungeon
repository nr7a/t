function TrinketAutomation.FindFuseTriple()
    local cached = TrinketAutomation.Cache
    if not cached then
        cached = {}
        TrinketAutomation.Cache = cached
    end
    local replicationModule = ReplicatedStorage:FindFirstChild("ItemReplicationService")
    if not cached.Replication and replicationModule then pcall(function() cached.Replication = require(replicationModule) end) end
    local itemConfigModule = ReplicatedStorage:FindFirstChild("ItemConfig")
    if not cached.ItemConfig and itemConfigModule then pcall(function() cached.ItemConfig = require(itemConfigModule) end) end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    cached.AccessoryInteract = cached.AccessoryInteract or (remotes and remotes:FindFirstChild("AccessoryInteract"))
    local replication = cached.Replication
    local itemConfig = cached.ItemConfig
    local quantityKey = replication and replication.KEYS and replication.KEYS.QUANTITY
    local keys = replication and replication.KEYS
    local modifierKey = keys and (keys.ACCESSORY_MODIFIERS or keys.ACCESSORY_MODIFIER or keys.ACCESSORY_MODIFIER_LIST)
    if not replication or not itemConfig or not quantityKey or not modifierKey or not cached.AccessoryInteract then
        return nil, nil, nil, "Trinket inventory/config/remotes unavailable"
    end

    local ok, iterator, state, seed = pcall(function() return replication:GetItems(quantityKey) end)
    if not ok then return nil, nil, nil, "Trinket inventory read failed: " .. tostring(iterator) end
    local grouped = {}
    local function consider(record)
        if type(record) ~= "table" or not record.NetworkedUID or (tonumber(record.Value) or 0) <= 0 then return end
        local itemId = record.ItemId
        local uid = record.NetworkedUID
        local configOk, cfg = pcall(function() return itemConfig.match(itemId):unwrap() end)
        if not configOk or type(cfg) ~= "table" or type(cfg.Display) ~= "table" then return end
        local displayName = tostring(cfg.Display.Name or (cfg.Index and cfg.Index.StorageKey) or "")
        local category = tostring(cfg.Display.Category or "")
        local lowerName = displayName:lower()
        local isRing = category == "Ring" or category == "Trinket"
            or lowerName:find("ring", 1, true) ~= nil or lowerName:find("trinket", 1, true) ~= nil
        if not isRing then return end

        local grade = displayName:match("[Gg]rade%s+II%s*$") and 2
            or (displayName:match("[Gg]rade%s+I%s*$") and 1)
            or (displayName:match("%s+II%s*$") and 2)
            or (displayName:match("%s+I%s*$") and 1)
        if not grade then return end

        local modOk, modifierValue = pcall(function()
            return replication:ReadItem(modifierKey, itemId, uid)
        end)
        if not modOk then return end
        local modifierCount = 0
        if type(modifierValue) == "table" then
            for _, modifier in pairs(modifierValue) do
                if modifier ~= nil and modifier ~= false and tostring(modifier) ~= "" then modifierCount += 1 end
            end
        elseif type(modifierValue) == "string" then
            local clean = modifierValue:gsub("%s+", "")
            if clean ~= "" and clean ~= "[]" and clean ~= "{}" and clean ~= "nil" then
                for token in clean:gmatch("[^,]+") do if token ~= "" then modifierCount += 1 end end
            end
        elseif type(modifierValue) == "number" then
            modifierCount = math.max(0, modifierValue)
        elseif modifierValue ~= nil and modifierValue ~= false then
            modifierCount = 1
        end
        if modifierCount ~= 0 then return end

        local baseName = displayName
            :gsub("[Gg]rade%s+II%s*$", "")
            :gsub("[Gg]rade%s+I%s*$", "")
            :gsub("%s+II%s*$", "")
            :gsub("%s+I%s*$", "")
            :gsub("%s+$", "")
        local groupKey = baseName .. "|" .. tostring(grade)
        grouped[groupKey] = grouped[groupKey] or {}
        table.insert(grouped[groupKey], { UID = uid, ItemId = itemId })
    end

    if type(iterator) == "function" then
        for key, value in iterator, state, seed do
            consider(type(value) == "table" and value or key)
        end
    elseif type(iterator) == "table" then
        for _, record in pairs(iterator) do consider(record) end
    else
        return nil, nil, nil, "Trinket inventory iterator unavailable"
    end

    local keys = {}
    for key in pairs(grouped) do keys[#keys + 1] = key end
    table.sort(keys)
    for _, key in ipairs(keys) do
        local list = grouped[key]
        table.sort(list, function(a, b) return tostring(a.UID) < tostring(b.UID) end)
        if #list >= 3 then return list[1], list[2], list[3], cached.AccessoryInteract end
    end
    return nil, nil, nil, "No three matching clean Grade I/II rings found"
end

function TrinketAutomation.StartWorker()
    if TrinketAutomation.WorkerStarted then return end
    TrinketAutomation.WorkerStarted = true
    task.spawn(function()
        local nextBuy, nextFuse, nextAction = 0, 0, 0
        local lastWarning = 0
        local function reportError(message)
            if os.clock() - lastWarning >= 30 then
                lastWarning = os.clock()
                warn("[Dungeon Trinkets]", tostring(message))
            end
        end
        while scriptRunning and (Config.AutoBuyTrinkets or Config.AutoFuseCleanTrinkets) do
            local now = os.clock()
            if now >= nextAction then
                local buyDue = Config.AutoBuyTrinkets and now >= nextBuy
                local fuseDue = Config.AutoFuseCleanTrinkets and now >= nextFuse
                if buyDue then
                    local ok, result = TrinketAutomation.BuyOnce()
                    if not ok then reportError("purchase request failed: " .. tostring(result)) end
                    nextBuy = os.clock() + 3
                    nextAction = os.clock() + 2
                elseif fuseDue then
                    local a, b, c, accessoryOrError = TrinketAutomation.FindFuseTriple()
                    if a and accessoryOrError then
                        local fuseOk, result = pcall(function() return accessoryOrError:InvokeServer("a", a.UID, b.UID, c.UID) end)
                        if not fuseOk or result == false or (type(result) == "table" and result.Success == false) then
                            reportError("fusion rejected: " .. tostring(result))
                        end
                        nextFuse = os.clock() + 3
                        nextAction = os.clock() + 2
                    else
                        if accessoryOrError then reportError(accessoryOrError) end
                        nextFuse = os.clock() + 1
                    end
                end
            end
            task.wait(0.1)
        end
        TrinketAutomation.WorkerStarted = false
    end)
end

