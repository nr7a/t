local function doOneShotOnTarget(tar, hrp)
    local MAX_VEC = Vector3.new(9e30, 9e30, 9e30)
    if not tar or not tar:FindFirstChild("HumanoidRootPart") then return false end

    local char = player.Character
    if not char then return false end

    local tarHrp = tar.HumanoidRootPart
    local targetPos = tarHrp.Position + Vector3.new(0, getAboveMonsterOffset(), 0)
    flyTo(CFrame.new(targetPos), CONFIG.TweenSpeed)

    local maxWait = math.clamp((hrp.Position - targetPos).Magnitude / math.max(1, CONFIG.TweenSpeed) + 3, 4, 20)
    local arriveStart = tick()
    local lastReissue = tick()
    local arrived = false
    while scriptRunning do
        local curChar = player.Character
        local curHrp = curChar and curChar:FindFirstChild("HumanoidRootPart")
        if not curHrp then return false end
        if (curHrp.Position - targetPos).Magnitude <= 12 then
            arrived = true
            break
        end
        if tick() - arriveStart > maxWait then return false end

        if tick() - lastReissue > 0.5 then
            lastReissue = tick()
            flyTo(CFrame.new(targetPos), CONFIG.TweenSpeed)
        end
        task.wait(0.05)
    end
    if not arrived then return false end

    local checkHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not checkHrp or (checkHrp.Position - targetPos).Magnitude > 20 then return false end

    task.wait(1)

    char = player.Character
    if not char then return false end
    local fruit = getM1FruitTool()
    if not fruit or not isOneShotFruit(fruit.Name) then return false end

    if fruit.Parent ~= char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum:EquipTool(fruit) end
        task.wait(0.15)
        fruit = getM1FruitTool()
        if not fruit or not isOneShotFruit(fruit.Name) then return false end
    end

    local remote = fruit:FindFirstChild("LeftClickRemote")
        or fruit:FindFirstChild("ClickRemote")
        or fruit:FindFirstChild("M1Remote")
    if not remote then
        for _, v in ipairs(fruit:GetChildren()) do
            if v:IsA("RemoteEvent") and v.Name:lower():find("click") then
                remote = v
                break
            end
        end
    end
    if remote then
        local combo = getMaxCombo(fruit)
        pcall(function() remote:FireServer(MAX_VEC, combo, false) end)
        print(string.format("[OneShot] 發射 (第 %s 關) 果實:%s 段數:%d",
            tostring(State.LockedLevel), fruit.Name, combo))
        task.wait(0.4)
        return true
    end
    task.wait(0.4)
    return false
end

local function oneShotLoop()
    local isTransitioning = false
    local lastOneShotFire = 0
    while scriptRunning do
        task.wait(0.05)

        if followingPlayerNow then continue end
        if not Config.OneShotEnabled then continue end
        if not ONE_SHOT_LEVELS[State.LockedLevel] then continue end
        if isTyping() then continue end

        local activeFruit = getM1FruitTool()
        if not activeFruit or not isOneShotFruit(activeFruit.Name) then continue end

        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then
            task.wait(0.5)
            continue
        end

        local enemies = getOneShotEnemies(hrp)
        if #enemies == 0 then
            if not isTransitioning then
                isTransitioning = true
                local exit = getOneShotExit(hrp)
                if exit then
                    pcall(function()
                        firetouchinterest(exit, hrp, 0)
                        task.wait(0.08)
                        firetouchinterest(exit, hrp, 1)
                    end)
                end
                task.wait(0.5)
                isTransitioning = false
            end
        else
            if oneShotTargetIndex > #enemies then oneShotTargetIndex = 1 end
            local tar = enemies[oneShotTargetIndex] or enemies[1]
            local fired = doOneShotOnTarget(tar, hrp)
            if fired then
                lastOneShotFire = tick()
                oneShotTargetIndex = (oneShotTargetIndex % #enemies) + 1
            elseif tick() - lastOneShotFire > 2 then
                
                oneShotTargetIndex = 1
                lastOneShotFire = tick()
            end
        end
    end
end

