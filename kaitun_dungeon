local function SetFastMode(enabled)
    local Global = require(ReplicatedStorage.Global)
    if enabled then
        if Global.FastMode then return end
        Global.reducing = true
        Global.FastMode = true
        Global.FastModeCache = {}

        local Map = workspace:WaitForChild("Map", 30)
        local Unloaded = ReplicatedStorage:WaitForChild("Unloaded", 30)
        if not Map or not Unloaded then
            Global.FastMode = false
            Global.reducing = false
            return
        end

        local os_clock = os.clock
        local task_wait = task.wait
        local SmoothPlastic = Enum.Material.SmoothPlastic

        local function optimize(container)
            local stamp = os_clock()
            for _, v in next, container do
                if v:IsA("BasePart") then
                    Global.FastModeCache[v] = v.Material
                    v.Material = SmoothPlastic
                    if os_clock() - stamp > 0.008333333333333333 then
                        task_wait()
                        stamp = os_clock()
                    end
                end
            end
        end

        optimize(Map:GetDescendants())
        optimize(Unloaded:GetDescendants())

        local OptimizerClientActor = player.PlayerScripts:FindFirstChild("OptimizerClientActor")
        if OptimizerClientActor and OptimizerClientActor.SendMessage then
            OptimizerClientActor:SendMessage("Optimize", true)
        end
    else
        Global.FastMode = false
        Global.reducing = false
        if Global.FastModeCache then
            for part, material in pairs(Global.FastModeCache) do
                if part and part.Parent then
                    part.Material = material
                end
            end
        end
        Global.FastModeCache = nil
        local OptimizerClientActor = player.PlayerScripts:FindFirstChild("OptimizerClientActor")
        if OptimizerClientActor and OptimizerClientActor.SendMessage then
            OptimizerClientActor:SendMessage("Optimize", false)
        end
    end
end

