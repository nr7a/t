                        and type(rawget(selector, "onClose")) == "function" then
                        for _, offered in pairs(rawget(selector, "buffs")) do
                            if type(offered) == "table" and rawget(offered, "buffName") == rawget(props, "buffName") then
                                local submit = rawget(selector, "onClose")
                                runtimeState.rememberSource(submit)
                                return {Group = selector, Function = submit, BuffName = rawget(props, "buffName")}
                            end
