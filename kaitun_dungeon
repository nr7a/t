runtimeState.report = function(reason)
    if os.clock() - runtimeState.LastReport < 10 then return end
    runtimeState.LastReport = os.clock()
    local file = "DungeonHubSettings/AutoCard_Runtime_" .. tostring(player.UserId) .. ".txt"
    local lines = {"AutoCard selector fix v3.1", "reason=" .. tostring(reason), "userId=" .. tostring(player.UserId),
        "visibleContainers=" .. tostring(runtimeState.VisibleContainers), "activeCards=" .. tostring(runtimeState.ActiveCards)}
    for _, line in ipairs(runtimeState.Trace) do lines[#lines + 1] = line end
    local function save()
        pcall(function()
            if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder("DungeonHubSettings") then makefolder("DungeonHubSettings") end
            if type(writefile) == "function" then writefile(file, table.concat(lines, "\n")) end
        end)
    end
    if runtimeState.SourceText then lines[#lines + 1] = runtimeState.SourceText end
    save()
    
    if not runtimeState.SourceDumpStarted and type(decompile) == "function" then
        local targets = {}
        for obj in pairs(runtimeState.SourceScripts) do if #targets < 2 then targets[#targets + 1] = obj end end
        if #targets > 0 then
            runtimeState.SourceDumpStarted = true
            local generation = runtimeState.LastReport
            task.spawn(function()
                local sourceLines = {}
                for _, obj in ipairs(targets) do
                    sourceLines[#sourceLines + 1] = "===== COMPONENT SOURCE " .. runtimeState.path(obj) .. " ====="
                    local done, good, source = false, false, nil
                    local worker = task.spawn(function() good, source = pcall(decompile, obj); done = true end)
                    local deadline = os.clock() + 8
                    while not done and runtimeState.Running and os.clock() < deadline do task.wait(0.1) end
                    if done then sourceLines[#sourceLines + 1] = good and tostring(source):sub(1, 100000) or ("decompile failed: " .. tostring(source))
                    else pcall(task.cancel, worker); sourceLines[#sourceLines + 1] = "decompile timed out" end
                end
                
                runtimeState.SourceText = table.concat(sourceLines, "\n")
                if runtimeState.LastReport == generation then lines[#lines + 1] = runtimeState.SourceText; save() end
            end)
        end
    end
    if os.clock() - runtimeState.LastWarning >= 8 then
