local i18nRegistry = {}
local i18nCurrent = Config.Language or "zh"
local langToggleObj = nil
local refreshFollowPlayerDropdown = nil

local function T(zh, en)
    if i18nCurrent == "en" then return en or zh end
    return zh
end

local function TranslateStatic(zh)
    if i18nCurrent == "en" then return TRANSLATIONS[zh] or zh end
    return zh
end

local function RegisterText(obj, zhText)
    if not obj then return end
    table.insert(i18nRegistry, { obj = obj, zh = zhText })
    obj.Text = TranslateStatic(zhText)
end

local function SetLanguage(lang)
    i18nCurrent = (lang == "en") and "en" or "zh"
    for _, entry in ipairs(i18nRegistry) do
        pcall(function()
            if entry.obj and entry.obj.Parent ~= nil then
                entry.obj.Text = TranslateStatic(entry.zh)
            end
        end)
    end
    if langToggleObj then
        pcall(function()
            langToggleObj:SetTitle((i18nCurrent == "en") and "Switch to Chinese" or "Switch to English")
        end)
    end
    if refreshFollowPlayerDropdown then
        pcall(refreshFollowPlayerDropdown)
    end
end

