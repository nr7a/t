runtimeState.bindings = function(button)
    local ready, states = {}, {}
    if type(getconnections) ~= "function" then return ready, "getconnections unavailable" end
    local ok, list = pcall(function() return getconnections(button.Activated) end)
    if not ok then return ready, "getconnections error: " .. tostring(list) end
    for _, connection in ipairs(list) do
        local fn = runtimeState.read(connection, "Function")
        if runtimeState.read(connection, "Enabled") ~= false and type(fn) == "function" then
            local manager = runtimeState.reactManager(fn, button)
            if manager then
                local status = rawget(manager, "_status")
                local listener = rawget(rawget(manager, "_listeners"), "Activated")
                runtimeState.rememberSource(listener)
                states[#states + 1] = "React=" .. tostring(status) .. "/listener=" .. type(listener)
                if status == "Enabled" and type(listener) == "function" then
                    ready[#ready + 1] = {Kind = "react", Manager = manager, Connection = connection, Function = fn}
                end
            else
                local di, source = pcall(function() return debug.info(fn, "s") end)
                if di and tostring(source):find("SingleEventManager", 1, true) then
                    states[#states + 1] = "React manager unavailable"
                else
                    runtimeState.rememberSource(fn)
                    ready[#ready + 1] = {Kind = "plain", Connection = connection, Function = fn}
                    states[#states + 1] = "plain Activated"
                end
            end
