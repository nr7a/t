            if settingsPath == LEGACY_FILE then
                
                Config.AutoStartDungeon = false
                Config.AutoStartDelay = 15
                Config.FollowPlayerEnabled = false
                Config.FollowPlayerName = "__SELF__"
                SaveSettings()
            end
        else
            SaveSettings()
        end
    end)
