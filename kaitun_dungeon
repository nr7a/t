local currentTween = nil

local FLY_EASING_STYLE = Enum.EasingStyle.Linear
local FLY_EASING_DIRECTION = Enum.EasingDirection.Out
local function flyTo(targetCFrame, customSpeed)
    if not hrp then return end
    local speed = customSpeed or CONFIG.TweenSpeed
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local time = distance / speed

    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    if time < 0.05 then hrp.CFrame = targetCFrame; return end

    local info = TweenInfo.new(time, FLY_EASING_STYLE, FLY_EASING_DIRECTION)
    currentTween = TweenService:Create(hrp, info, {CFrame = targetCFrame})
    currentTween:Play()
end
local function stopFly()
    if currentTween then currentTween:Cancel(); currentTween = nil end
    pcall(function()
        if hrp then
            local flyBv = hrp:FindFirstChild("FlyVelocity")
            if flyBv then flyBv:Destroy() end
        end
    end)
end

local function ensureFlyVelocity()
    if not hrp then return end
    local flyBv = hrp:FindFirstChild("FlyVelocity")
    if not flyBv then
        flyBv = Instance.new("BodyVelocity")
        flyBv.Name = "FlyVelocity"
        flyBv.Velocity = Vector3.new(0, 0, 0)
        flyBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        flyBv.Parent = hrp
    end
end

