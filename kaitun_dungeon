local function freshVIdx()
    return { v21 = nil, v22 = nil, v23 = nil, v24 = nil, v25 = nil, v26 = nil, v27 = nil }
end
local V_Idx = freshVIdx()

local function analyzeShootFunction(f)
    if type(f) ~= "function" or not getupvals then return nil end
    local ok, uvs = pcall(getupvals, f)
    if not ok or type(uvs) ~= "table" or #uvs < 7 then return nil end

    local best
    for pivot = 4, (#uvs - 3) do
        local a, b, c, d = uvs[pivot], uvs[pivot - 2], uvs[pivot + 1], uvs[pivot + 2]
        local e, s2, g = uvs[pivot - 1], uvs[pivot - 3], uvs[pivot + 3]

        if type(a) == "number" and type(b) == "number" and type(c) == "number" and type(d) == "number"
            and type(e) == "number" and type(s2) == "number" and type(g) == "number"
            and c > 1 and d > 1 and a ~= 0 and b ~= 0
            and s2 == math.floor(s2) and e == math.floor(e) and g == math.floor(g)
            and s2 >= 0 and s2 < c and e >= 0 and g >= 0 then

            local v8 = s2 * b
            local v9 = (e * b + s2 * a) % c
            v9 = (v9 * c + v8) % d
            local code = math.floor(v9 / d * 16777215)

            if code >= 0 and code <= 16777215 then
                local score = 0
                if c > 1000 then score = score + 1 end
                if d > 1000 then score = score + 1 end
                if b > 1000 then score = score + 1 end
                if g > 0 then score = score + 1 end
                if #uvs >= 19 then score = score + 1 end
                if not best or score > best.score then
                    best = {
                        score = score,
                        idx = { v21 = pivot, v22 = pivot - 2, v25 = pivot - 1, v26 = pivot - 3,
                                v23 = pivot + 1, v24 = pivot + 2, v27 = pivot + 3 },
                    }
                end
            end
        end
    end
    return best
end

local function collectCandidates()
    local pool = {}
    local Controllers = ReplicatedStorage:FindFirstChild("Controllers")
    local ccModule = Controllers and (Controllers:FindFirstChild("CombatController") or Controllers:WaitForChild("CombatController", 5))
    if not ccModule then return pool end
    local ok, cc = pcall(require, ccModule)
    if not ok or type(cc) ~= "table" or type(cc.Attack) ~= "function" then return pool end
    pool[#pool + 1] = cc.Attack
    if not getupvals then return pool end

    local layer1 = {}
    local ok1, uvs1 = pcall(getupvals, cc.Attack)
    if ok1 and type(uvs1) == "table" then
        for _, v in ipairs(uvs1) do
            if type(v) == "function" then
                layer1[#layer1 + 1] = v
                pool[#pool + 1] = v
            end
        end
    end
    for _, f in ipairs(layer1) do
        local ok2, uvs2 = pcall(getupvals, f)
        if ok2 and type(uvs2) == "table" then
            for _, v in ipairs(uvs2) do
                if type(v) == "function" then pool[#pool + 1] = v end
            end
        end
    end
    return pool
end
local function initDragonGun()
    if ShootFunction and V_Idx.v21 then return end
    if not getupvals then return end

    local pool = collectCandidates()
    if #pool == 0 then return end

    local bestF, bestData, bestScore = nil, nil, -1
    for _, f in ipairs(pool) do
        local r = analyzeShootFunction(f)
        if r and r.score > bestScore then
            bestF, bestData, bestScore = f, r, r.score
        end
    end

    if bestF and bestData then
        ShootFunction = bestF
        V_Idx = bestData.idx
    else
        ShootFunction = nil
        V_Idx = freshVIdx()
    end
end
local function GetValidator2()
    if not ShootFunction or not V_Idx.v21 then
        initDragonGun()
    end
    if not ShootFunction or not V_Idx.v21 or not getupval or not setupval then return 0, 0 end

    local okValues, v1, v2, v3, v4, v5, v6, v7 = pcall(function()
        return getupval(ShootFunction, V_Idx.v21), getupval(ShootFunction, V_Idx.v22),
            getupval(ShootFunction, V_Idx.v23), getupval(ShootFunction, V_Idx.v24),
            getupval(ShootFunction, V_Idx.v25), getupval(ShootFunction, V_Idx.v26),
            getupval(ShootFunction, V_Idx.v27)
    end)

    if not okValues or type(v1) ~= "number" or type(v2) ~= "number" or type(v3) ~= "number"
        or type(v4) ~= "number" or type(v5) ~= "number" or type(v6) ~= "number" or type(v7) ~= "number"
        or v3 == 0 or v4 == 0 then
        ShootFunction = nil
        V_Idx = freshVIdx()
        return 0, 0
    end

    local v8 = v6 * v2
    local v9 = (v5 * v2 + v6 * v1) % v3
    v9 = (v9 * v3 + v8) % v4
    v5 = math.floor(v9 / v3)
    v6 = v9 - v5 * v3
    v7 = v7 + 1

    local okSetup = pcall(function()
        setupval(ShootFunction, V_Idx.v25, v5)
        setupval(ShootFunction, V_Idx.v26, v6)
        setupval(ShootFunction, V_Idx.v27, v7)
    end)
    if not okSetup then
        ShootFunction = nil
        V_Idx = freshVIdx()
        return 0, 0
    end

    return math.floor(v9 / v4 * 16777215), v7
end

