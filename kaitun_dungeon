local function enableAnimatedDrag(handle, target, onClick)
    local dragging = false
    local moved = false
    local dragStart, startPos
    local dragTween = nil

    local function endDrag()
        if dragging then
            dragging = false
            if dragTween then
                dragTween:Cancel()
                dragTween = nil
            end
        end
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = target.Position
        end
    end)

    table.insert(uiConnections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and not moved and onClick then
                onClick()
            end
            endDrag()
        end
    end))

    table.insert(uiConnections, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
                moved = true
            end
            
            local targetPos = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
            
            if dragTween then dragTween:Cancel() end
            dragTween = TweenService:Create(target, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = targetPos })
            dragTween:Play()
        end
    end))
end

