runtimeState.rememberSource = function(fn)
    if type(fn) ~= "function" or type(getfenv) ~= "function" then return end
    local ok, env = pcall(getfenv, fn)
    local obj = ok and type(env) == "table" and rawget(env, "script") or nil
    if typeof(obj) == "Instance" and (obj:IsA("ModuleScript") or obj:IsA("LocalScript")) then
