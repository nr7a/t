    local readUpvalues = (debug and debug.getupvalues) or getupvalues
    if type(readUpvalues) ~= "function" then return nil end
    local ok, values = pcall(readUpvalues, fn)
    if not ok or type(values) ~= "table" then return nil end

    for _, value in pairs(values) do
        if type(value) == "table" and rawget(value, "_instance") == button
            and type(rawget(value, "_listeners")) == "table"
