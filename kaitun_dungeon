    local scriptObject = ok and type(env) == "table" and rawget(env, "script") or nil
    if not scriptObject or runtimeState.path(scriptObject) ~= "ReplicatedStorage.DungeonClient.Interface.BuffSelector" then
        return nil, "unverified component source"
    end
    for _, props in pairs(runtimeState.upvalues(listener)) do
        if type(props) == "table" and type(rawget(props, "buffName")) == "string"
            and type(rawget(props, "onClose")) == "function" then
            local ref = rawget(props, "cardInstanceRef")
            if type(ref) == "table" and runtimeState.read(ref, "current") == button and not rawget(props, "nonSelectable") then
                for _, selector in pairs(runtimeState.upvalues(rawget(props, "onClose"))) do
