local function makeToggle(col, title, default, callback, skipI18n, noTruncate)
    local isLocked = false
    local state = default == true

    local row = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Text = "",
