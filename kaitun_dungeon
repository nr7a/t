local function updateUIScale()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    if isMobileDevice then
        
        baseScale = math.clamp(math.min(1, vp.X / 900, vp.Y / 750), 0.4, 0.8)
        local rawOpen = math.min(vp.X / 700, vp.Y / 600)
        openBaseScale = math.clamp(rawOpen, 0.6, 0.9)
    else
        baseScale = math.clamp(math.min(1, vp.X / 680, vp.Y / 540), 0.5, 1)
        local rawOpen = math.min(vp.X / 640, vp.Y / 480)
        if rawOpen > 1 then
            openBaseScale = math.min(1 + (rawOpen - 1) * 0.35, 1.4)
        else
            openBaseScale = math.clamp(rawOpen, 0.55, 1)
        end
    end
    if not isAnimating then
        uiScale.Scale = baseScale
        if openScale then
            openScale.Scale = openBaseScale
        end
    end
end
local function hookCamera()
    local cam = workspace.CurrentCamera
    if not cam then return end
    if cameraConn then cameraConn:Disconnect() end
    cameraConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateUIScale)
    updateUIScale()
end
